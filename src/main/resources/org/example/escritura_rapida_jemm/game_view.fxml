<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.escritura_rapida_jemm.controllers.GameController">
   <children>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label fx:id="nicknameLabel" prefHeight="37.0" prefWidth="179.0" text="PLAYER:">
               <font>
                  <Font size="26.0" />
               </font>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </Label>
            <Pane prefHeight="60.0" prefWidth="128.0" />
            <Pane prefHeight="200.0" prefWidth="200.0">
               <children>
                  <HBox alignment="TOP_CENTER" layoutX="-114.0" layoutY="10.0" prefHeight="100.0" prefWidth="353.0">
                     <children>
                        <Label fx:id="hitsLabel" alignment="CENTER" contentDisplay="CENTER" text="HITS:">
                           <opaqueInsets>
                              <Insets />
                           </opaqueInsets>
                           <font>
                              <Font size="26.0" />
                           </font>
                           <padding>
                              <Insets right="50.0" />
                           </padding>
                        </Label>
                        <Label fx:id="timeLabel" alignment="CENTER" text="TIME:" textAlignment="CENTER">
                           <font>
                              <Font size="26.0" />
                           </font>
                           <padding>
                              <Insets left="50.0" />
                           </padding>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </Pane>
         </children>
      </HBox>
      <Label fx:id="writeWordLabel" text="WORD TO WRITE DOWN" underline="true">
         <font>
            <Font size="43.0" />
         </font>
      </Label>
      <TextField fx:id="inputWordTextField" alignment="CENTER" onKeyPressed="#onKeyEnterPressed" promptText="write here">
         <font>
            <Font size="37.0" />
         </font>
         <padding>
            <Insets bottom="100.0" left="100.0" right="100.0" top="100.0" />
         </padding>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </TextField>
      <Button fx:id="startGameButton" mnemonicParsing="false" onAction="#onActionVerifyButton" onKeyPressed="#onKeyEnterPressed" text="START" />
   </children>
</VBox>
