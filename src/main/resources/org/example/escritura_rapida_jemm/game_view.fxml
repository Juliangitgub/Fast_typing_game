<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="700.0" spacing="20" style="-fx-background-color: #1e1e2f;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.escritura_rapida_jemm.controllers.GameController">

    <!-- Header: Player info + Hits + Time -->
    <HBox alignment="CENTER" spacing="50">
        <Label fx:id="nicknameLabel" text="PLAYER: " textFill="white">
            <font>
                <Font size="28" />
            </font>
        </Label>

        <Label fx:id="hitsLabel" text="HITS: 0" textFill="white">
            <font>
                <Font size="28" />
            </font>
        </Label>

        <Label fx:id="timeLabel" text="TIME: 20" textFill="white">
            <font>
                <Font size="28" />
            </font>
        </Label>
    </HBox>

    <!-- Word to write -->
    <Label fx:id="writeWordLabel" text="WORD TO WRITE" textFill="#FFD700" underline="true">
        <font>
            <Font size="42" />
        </font>
    </Label>

    <!-- Input field -->
    <TextField fx:id="inputWordTextField" alignment="CENTER" onKeyPressed="#onKeyEnterPressed" prefHeight="60" prefWidth="400" promptText="Type here..." style="-fx-font-size: 30px; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #888;">
      <font>
         <Font size="26.0" />
      </font></TextField>

    <!-- Alerts -->
    <Label fx:id="alertsLabel" text="ALERTS" textFill="red">
        <font>
            <Font size="24" />
        </font>
    </Label>

    <!-- Start/Verify button -->
    <Button fx:id="startGameButton" mnemonicParsing="false" onAction="#onActionVerifyButton" onKeyPressed="#onKeyEnterPressed" prefHeight="60" prefWidth="200" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 15;" text="START">
    </Button>

</VBox>
