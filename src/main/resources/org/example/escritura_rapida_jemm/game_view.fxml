<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20" prefHeight="500.0" prefWidth="700.0"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.escritura_rapida_jemm.controllers.GameController"
      style="-fx-background-color: #1e1e2f;">

    <!-- Header: Player info + Hits + Time -->
    <HBox alignment="CENTER" spacing="50">
        <Label fx:id="nicknameLabel" text="PLAYER: " textFill="white">
            <font>
                <Font size="28"/>
            </font>
        </Label>

        <Label fx:id="hitsLabel" text="HITS: 0" textFill="white">
            <font>
                <Font size="28"/>
            </font>
        </Label>

        <Label fx:id="timeLabel" text="TIME: 20" textFill="white">
            <font>
                <Font size="28"/>
            </font>
        </Label>
    </HBox>

    <!-- Word to write -->
    <Label fx:id="writeWordLabel" text="WORD TO WRITE" underline="true" textFill="#FFD700">
        <font>
            <Font size="42"/>
        </font>
    </Label>

    <!-- Input field -->
    <TextField fx:id="inputWordTextField" alignment="CENTER" promptText="Type here..."
               onKeyPressed="#onKeyEnterPressed"
               prefWidth="400" prefHeight="60" style="-fx-font-size: 30px; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #888;">
    </TextField>

    <!-- Alerts -->
    <Label fx:id="alertsLabel" text="ALERTS" textFill="red">
        <font>
            <Font size="24"/>
        </font>
    </Label>

    <!-- Start/Verify button -->
    <Button fx:id="startGameButton" text="START" mnemonicParsing="false"
            onAction="#onActionVerifyButton" onKeyPressed="#onKeyEnterPressed"
            prefWidth="200" prefHeight="60"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 15;">
    </Button>

</VBox>
